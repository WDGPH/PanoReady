<?xml version="1.0" encoding="utf-8"?>
<ns1:SchoolUpload
  xmlns:ns1="http://ontario.ca"
  xmlns:rogue="urn:panoready:unexpected-demo"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- File-level, student, and guardian phones share the same rules. -->
  <ns1:Metadata>
    <!-- Known gaps: impossible calendar/time values are currently not reported. -->
    <ns1:CreateDate>2026-02-30</ns1:CreateDate>
    <ns1:CreateTime>25:61:61</ns1:CreateTime>
    <ns1:CreatedBy>Pear Orchard</ns1:CreatedBy>
    <!-- Auto-fix: common "ext." variant becomes lowercase x plus 1-5 digits. -->
    <ns1:ContactPhone type="WORK">519-824-1000 ext. 10</ns1:ContactPhone>
    <ns1:ContactEmail>pear.orchard@example.invalid</ns1:ContactEmail>
    <!-- Known gap: unexpected upload-mode values are currently not reported. -->
    <ns1:FullUpload>MAYBE</ns1:FullUpload>
  </ns1:Metadata>
  <ns1:School>
    <ns1:SchoolNumber>12345</ns1:SchoolNumber>
    <ns1:Name>Synthetic Produce Academy</ns1:Name>
    <ns1:Students>
      <!-- Student 0: canonical extension plus two manual guardian-extension errors -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Apple</ns1:First>
          <ns1:Last>Crisp</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2010-05-12</ns1:BirthDate>
        <ns1:Grade>GR6</ns1:Grade>
        <ns1:Gender>F</ns1:Gender>
        <ns1:OEN>123456789</ns1:OEN>
        <ns1:Guardian>
          <ns1:Name><ns1:First>Captain</ns1:First><ns1:Last>Carrot</ns1:Last></ns1:Name>
          <ns1:Relationship>LEGALGRD</ns1:Relationship>
          <!-- Manual: extension marker has no digits. -->
          <ns1:Phone type="HOME">416-555-1111x</ns1:Phone>
        </ns1:Guardian>
        <ns1:Guardian>
          <ns1:Name><ns1:First>Princess</ns1:First><ns1:Last>Pea</ns1:Last></ns1:Name>
          <ns1:Relationship>OTHER</ns1:Relationship>
          <!-- Manual: extension is not numeric. -->
          <ns1:Phone type="MOBILE">416-555-2222 ext ABC</ns1:Phone>
        </ns1:Guardian>
        <ns1:Phone type="MOBILE">416-555-1234x12345</ns1:Phone>
        <ns1:Address>
          <ns1:City>Ottawa</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>K1A0B1</ns1:PostalCode>
          <ns1:StreetNumber>12</ns1:StreetNumber>
          <ns1:StreetName>Main St</ns1:StreetName>
          <ns1:Unit>4</ns1:Unit>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 1: missing BirthDate (required), whitespace, alias grade, placeholder phone, invalid province/postal, length issues -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>  Broccoli  </ns1:First>
          <ns1:Last>Sprout</ns1:Last>
        </ns1:Name>
        <ns1:Grade>K</ns1:Grade>
        <ns1:Gender>Other</ns1:Gender>
        <ns1:OEN>000000001</ns1:OEN>
        <ns1:Phone>519-000-0000</ns1:Phone>
        <ns1:Address>
          <ns1:City>Toronto</ns1:City>
          <ns1:Province>ZZ</ns1:Province>
          <ns1:PostalCode>12345</ns1:PostalCode>
          <ns1:StreetNumber>1234567</ns1:StreetNumber>
          <ns1:StreetName>Very Long Street Name That Exceeds The Normal Length For Testing Purposes</ns1:StreetName>
          <ns1:Unit>Apartment 123456</ns1:Unit>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 2: invalid OEN format; phone digits-only (auto-fixable) -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Alice</ns1:First>
          <ns1:Last>Wonderland</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2011-07-01</ns1:BirthDate>
        <ns1:Grade>GR13</ns1:Grade>
        <ns1:Gender>Unk</ns1:Gender>
        <ns1:OEN>ABC123</ns1:OEN>
        <ns1:Phone>4165556789</ns1:Phone>
        <ns1:Address>
          <ns1:City>Kingston</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>K7L 3N6</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 3: duplicate name+dob with student 2, valid OEN for duplicate detection -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Alice</ns1:First>
          <ns1:Last>Wonderland</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2011-07-01</ns1:BirthDate>
        <ns1:Grade>GR11</ns1:Grade>
        <ns1:Gender>M</ns1:Gender>
        <ns1:OEN>222333444</ns1:OEN>
        <ns1:Phone>(416) 555-0000</ns1:Phone>
        <ns1:Address>
          <ns1:City>Kingston</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>K7L3N6</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 4: duplicate OEN with student 3 -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Blue</ns1:First>
          <ns1:Last>Berry</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2012-03-10</ns1:BirthDate>
        <ns1:Grade>1</ns1:Grade>
        <ns1:Gender>N</ns1:Gender>
        <ns1:OEN>222333444</ns1:OEN>
        <ns1:Phone>1-416-555-9999</ns1:Phone>
        <ns1:Address>
          <ns1:City>Ottawa</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>K1A 0B1</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Postal-code focused cases: deterministic fixes and unresolved errors -->

      <!-- Student 5: I-to-1 substitutions in numeric positions plus slash normalization -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Indiana</ns1:First>
          <ns1:Last>Jones</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-01-05</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000005</ns1:OEN>
        <!-- Auto-fix: uppercase X becomes canonical lowercase x. -->
        <ns1:Phone>519-824-1234X12</ns1:Phone>
        <ns1:Address>
          <ns1:City>Guelph</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>NIG/2WI</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 6: L-to-1 substitution in a numeric position -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Lara</ns1:First>
          <ns1:Last>Croft</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-02-06</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000006</ns1:OEN>
        <ns1:Phone>519-124-1234</ns1:Phone>
        <ns1:Address>
          <ns1:City>Guelph</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>NLG2W1</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 7: O-to-0 substitution in a numeric position (valid rural FSA) -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Oscar</ns1:First>
          <ns1:Last>Grouch</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-03-07</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000007</ns1:OEN>
        <!-- Auto-fix: hash extension marker becomes canonical x. -->
        <ns1:Phone>212-555-1234 #23</ns1:Phone>
        <ns1:Address>
          <ns1:City>Guelph</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>NOG2W1</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 8: lowercase plus a Unicode dash; formatting-only normalization -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Princess</ns1:First>
          <ns1:Last>Peach</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-04-08</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000008</ns1:OEN>
        <!-- Auto-fix: country code, formatting, and spaced extension marker. -->
        <ns1:Phone>+1 (519) 824-1234 x 45</ns1:Phone>
        <ns1:Address>
          <ns1:City>Guelph</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>n1g—2w1</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 9: prohibited D in an alphabetic position; not auto-fixable -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Bugs</ns1:First>
          <ns1:Last>Bunny</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-05-09</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000009</ns1:OEN>
        <ns1:Phone>019-824-1234</ns1:Phone>
        <ns1:Address>
          <ns1:City>Guelph</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>N1D2W1</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 10: separator in the wrong position; not auto-fixable -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Kermit</ns1:First>
          <ns1:Last>Frog</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-06-10</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000010</ns1:OEN>
        <ns1:Phone>519-824-123</ns1:Phone>
        <ns1:Address>
          <ns1:City>Guelph</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>N1/G2W1</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 11: full-word extension variant; safely normalized -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Darth</ns1:First>
          <ns1:Last>Tater</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-07-11</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000011</ns1:OEN>
        <ns1:Phone>519-824-1234 extension 2</ns1:Phone>
        <ns1:Address>
          <ns1:City>Guelph</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>N1G!!!2W1</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Phone-focused cases retained from the former dedicated demo -->

      <!-- Student 12: NPA begins with 1; not auto-fixable -->
      <ns1:Student>
        <ns1:Name><ns1:First>One NPA</ns1:First><ns1:Last>Structure</ns1:Last></ns1:Name>
        <ns1:BirthDate>2014-08-12</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000012</ns1:OEN>
        <ns1:Phone>119-824-1234</ns1:Phone>
      </ns1:Student>

      <!-- Student 13: extension exceeds the maximum; not auto-fixable -->
      <ns1:Student>
        <ns1:Name><ns1:First>Too Many</ns1:First><ns1:Last>Digits</ns1:Last></ns1:Name>
        <ns1:BirthDate>2014-09-13</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000013</ns1:OEN>
        <ns1:Phone>519-824-1234x123456</ns1:Phone>
      </ns1:Student>

      <!-- Student 14: multiple numbers; not auto-fixable -->
      <ns1:Student>
        <ns1:Name><ns1:First>Multiple</ns1:First><ns1:Last>Numbers</ns1:Last></ns1:Name>
        <ns1:BirthDate>2014-10-14</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000014</ns1:OEN>
        <ns1:Phone>519-824-1234 / 416-555-1234</ns1:Phone>
      </ns1:Student>

      <!-- Student 15: future Canadian relief NPA; warning only -->
      <ns1:Student>
        <ns1:Name><ns1:First>Future Relief</ns1:First><ns1:Last>Policy</ns1:Last></ns1:Name>
        <ns1:BirthDate>2014-11-15</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000015</ns1:OEN>
        <ns1:Phone>851-555-1234</ns1:Phone>
      </ns1:Student>

      <!-- Student 16: French accents, ligatures, hyphens, and apostrophes are intentional valid data. -->
      <ns1:Student>
        <ns1:OEN>500000016</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name>
          <ns1:First>Élodie-Anne</ns1:First>
          <ns1:Middle>François</ns1:Middle>
          <ns1:Last>D’Artichaut</ns1:Last>
        </ns1:Name>
        <ns1:AliasName>
          <ns1:First>Maëlle</ns1:First>
          <ns1:Last>L’Œillet</ns1:Last>
        </ns1:AliasName>
        <ns1:Gender>F</ns1:Gender>
        <ns1:BirthDate>2014-12-16</ns1:BirthDate>
        <ns1:Address>
          <ns1:StreetNumber>16</ns1:StreetNumber>
          <ns1:StreetName>chemin de l’Érable</ns1:StreetName>
          <ns1:City>Trois-Rivières</ns1:City>
          <ns1:Province>QC</ns1:Province>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 17: known gap — correct-looking shape, impossible calendar date. -->
      <ns1:Student>
        <ns1:OEN>500000017</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Pumpkin</ns1:First><ns1:Last>Clock</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-02-30</ns1:BirthDate>
        <ns1:Address/>
      </ns1:Student>

      <!-- Student 18: known gap — an unexpected child is silently ignored. -->
      <ns1:Student>
        <ns1:OEN>500000018</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Mango</ns1:First><ns1:Last>Mystery</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-18</ns1:BirthDate>
        <ns1:FavouriteVegetable>Rutabaga</ns1:FavouriteVegetable>
        <ns1:Address/>
      </ns1:Student>

      <!-- Student 19: known gap — a third Guardian is accepted and ignored. -->
      <ns1:Student>
        <ns1:OEN>500000019</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Kale</ns1:First><ns1:Last>Trio</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-19</ns1:BirthDate>
        <ns1:Guardian><ns1:Relationship>LEGALGRD</ns1:Relationship></ns1:Guardian>
        <ns1:Guardian><ns1:Relationship>PARENT</ns1:Relationship></ns1:Guardian>
        <ns1:Guardian><ns1:Relationship>OTHER</ns1:Relationship></ns1:Guardian>
        <ns1:Address/>
      </ns1:Student>

      <!-- Student 20: known gaps — phone type and Guardian relationship are not checked. -->
      <ns1:Student>
        <ns1:OEN>500000020</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Radish</ns1:First><ns1:Last>Rocket</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-20</ns1:BirthDate>
        <ns1:Guardian><ns1:Relationship>NEIGHBOUR</ns1:Relationship></ns1:Guardian>
        <ns1:Address/>
        <ns1:Phone type="CARRIER-PIGEON">519-824-7777</ns1:Phone>
      </ns1:Student>

      <!-- Student 21: known gap — duplicate singleton fields collapse into a misleading missing-field issue. -->
      <ns1:Student>
        <ns1:OEN>500000021</ns1:OEN>
        <ns1:Grade>GR4</ns1:Grade>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Double</ns1:First><ns1:Last>Grade</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-21</ns1:BirthDate>
        <ns1:Address/>
      </ns1:Student>

      <!-- Student 22: known gap — a nil marker is silently treated as an empty Address. -->
      <ns1:Student>
        <ns1:OEN>500000022</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Invisible</ns1:First><ns1:Last>Asparagus</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-22</ns1:BirthDate>
        <ns1:Address xsi:nil="true"/>
      </ns1:Student>

      <!-- Student 23: known gap — duplicate Phone elements are collapsed and not reported as cardinality. -->
      <ns1:Student>
        <ns1:OEN>500000023</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Double</ns1:First><ns1:Last>Dial</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-23</ns1:BirthDate>
        <ns1:Address/>
        <ns1:Phone>519-824-7001</ns1:Phone>
        <ns1:Phone>519-824-7002</ns1:Phone>
      </ns1:Student>

      <!-- Student 24: known gaps — configured Language, Country, StreetType, and StreetDirection lists are not enforced. -->
      <ns1:Student>
        <ns1:OEN>500000025</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Configuration</ns1:First><ns1:Last>Mirage</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-25</ns1:BirthDate>
        <ns1:Language>KLINGON</ns1:Language>
        <ns1:CountryOfOrigin>MARS</ns1:CountryOfOrigin>
        <ns1:Address>
          <ns1:StreetNumber>25</ns1:StreetNumber>
          <ns1:StreetName>Configuration Crescent</ns1:StreetName>
          <ns1:StreetType>WORMHOLE</ns1:StreetType>
          <ns1:StreetDirection>UP</ns1:StreetDirection>
          <ns1:City>Ottawa</ns1:City>
          <ns1:Province>ON</ns1:Province>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 25: known gap — the required Address container is absent. -->
      <ns1:Student>
        <ns1:OEN>500000026</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Addressless</ns1:First><ns1:Last>Avocado</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-26</ns1:BirthDate>
      </ns1:Student>

      <!-- Student 26: known gap — familiar fields are accepted in an unexpected order. -->
      <ns1:Student>
        <ns1:Address/>
        <ns1:BirthDate>2014-01-27</ns1:BirthDate>
        <ns1:Gender>X</ns1:Gender>
        <ns1:Name><ns1:First>Orderly</ns1:First><ns1:Last>Onion</ns1:Last></ns1:Name>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:OEN>500000027</ns1:OEN>
      </ns1:Student>

      <!-- Known gap: content from an unexpected namespace is silently ignored. -->
      <rogue:Student>
        <rogue:Name>Namespace Nectarine</rogue:Name>
      </rogue:Student>

    </ns1:Students>
  </ns1:School>

  <!-- Second school: empty Students element -->
  <ns1:School>
    <ns1:Name>Empty Eggplant Secondary</ns1:Name>
    <ns1:Students/>
  </ns1:School>

  <!-- Third school: missing SchoolNumber and non-ISO BirthDate and invalid grade -->
  <ns1:School>
    <ns1:Name>No-Number Nectarine School</ns1:Name>
    <ns1:Students>
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Charlie</ns1:First>
          <ns1:Last>Brown</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2013/05/05</ns1:BirthDate>
        <ns1:Grade>GR100</ns1:Grade>
        <ns1:Gender>unknown</ns1:Gender>
        <ns1:OEN>333444555</ns1:OEN>
        <ns1:Phone>600-555-1234</ns1:Phone>
      </ns1:Student>
    </ns1:Students>
  </ns1:School>

  <!-- Fourth school: known gap — School Name is absent but currently unreported. -->
  <ns1:School>
    <ns1:SchoolNumber>67890</ns1:SchoolNumber>
    <ns1:Students>
      <ns1:Student>
        <ns1:OEN>500000024</ns1:OEN>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Name><ns1:First>Turnip</ns1:First><ns1:Last>Annex</ns1:Last></ns1:Name>
        <ns1:Gender>X</ns1:Gender>
        <ns1:BirthDate>2014-01-24</ns1:BirthDate>
        <ns1:Address/>
      </ns1:Student>
    </ns1:Students>
  </ns1:School>

</ns1:SchoolUpload>
