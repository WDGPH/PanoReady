<?xml version="1.0" encoding="utf-8"?>
<!-- Entirely synthetic demo data. Names are fictional, email uses .invalid,
     and valid-looking phone numbers use the reserved 555-01xx range. -->
<ns1:SchoolUpload xmlns:ns1="http://ontario.ca">
  <!-- File-level, student, and guardian phones share the same rules. -->
  <ns1:Metadata>
    <ns1:CreateDate>2026-09-01</ns1:CreateDate>
    <ns1:CreateTime>12:00:00</ns1:CreateTime>
    <ns1:CreatedBy>Synthetic Test Generator</ns1:CreatedBy>
    <!-- Auto-fix: common "ext." variant becomes lowercase x plus 1-5 digits. -->
    <ns1:ContactPhone type="WORK">204-555-0100 ext. 10</ns1:ContactPhone>
    <ns1:ContactEmail>pear.orchard@example.invalid</ns1:ContactEmail>
    <ns1:FullUpload>YES</ns1:FullUpload>
  </ns1:Metadata>
  <ns1:School>
    <ns1:SchoolNumber>12345</ns1:SchoolNumber>
    <ns1:Name>Synthetic Produce Academy</ns1:Name>
    <ns1:Students>
      <!-- Student 0: canonical extension plus two manual guardian-extension errors -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Apple</ns1:First>
          <ns1:Last>Crisp</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2010-05-12</ns1:BirthDate>
        <ns1:Grade>GR6</ns1:Grade>
        <ns1:Gender>F</ns1:Gender>
        <ns1:OEN>123456789</ns1:OEN>
        <ns1:Guardian>
          <ns1:Name><ns1:First>Captain</ns1:First><ns1:Last>Carrot</ns1:Last></ns1:Name>
          <ns1:Relationship>LEGALGRD</ns1:Relationship>
          <!-- Manual: extension marker has no digits. -->
          <ns1:Phone type="HOME">204-555-0101x</ns1:Phone>
        </ns1:Guardian>
        <ns1:Guardian>
          <ns1:Name><ns1:First>Princess</ns1:First><ns1:Last>Pea</ns1:Last></ns1:Name>
          <ns1:Relationship>OTHER</ns1:Relationship>
          <!-- Manual: extension is not numeric. -->
          <ns1:Phone type="MOBILE">204-555-0102 ext ABC</ns1:Phone>
        </ns1:Guardian>
        <ns1:Phone type="MOBILE">204-555-0103x12345</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>H0H0H0</ns1:PostalCode>
          <ns1:StreetNumber>12</ns1:StreetNumber>
          <ns1:StreetName>Example St</ns1:StreetName>
          <ns1:Unit>4</ns1:Unit>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 1: missing BirthDate (required), whitespace, alias grade, placeholder phone, invalid province/postal, length issues -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>  Broccoli  </ns1:First>
          <ns1:Last>Sprout</ns1:Last>
        </ns1:Name>
        <ns1:Grade>K</ns1:Grade>
        <ns1:Gender>Other</ns1:Gender>
        <ns1:OEN>000000001</ns1:OEN>
        <ns1:Phone>519-000-0000</ns1:Phone>
        <ns1:Address>
          <ns1:City>Sampletown</ns1:City>
          <ns1:Province>ZZ</ns1:Province>
          <ns1:PostalCode>12345</ns1:PostalCode>
          <ns1:StreetNumber>1234567</ns1:StreetNumber>
          <ns1:StreetName>Very Long Street Name That Exceeds The Normal Length For Testing Purposes</ns1:StreetName>
          <ns1:Unit>Apartment 123456</ns1:Unit>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 2: invalid OEN format; phone digits-only (auto-fixable) -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Alice</ns1:First>
          <ns1:Last>Wonderland</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2011-07-01</ns1:BirthDate>
        <ns1:Grade>GR13</ns1:Grade>
        <ns1:Gender>Unk</ns1:Gender>
        <ns1:OEN>ABC123</ns1:OEN>
        <ns1:Phone>4165556789</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>H0H 0H0</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 3: duplicate name+dob with student 2, valid OEN for duplicate detection -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Alice</ns1:First>
          <ns1:Last>Wonderland</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2011-07-01</ns1:BirthDate>
        <ns1:Grade>GR11</ns1:Grade>
        <ns1:Gender>M</ns1:Gender>
        <ns1:OEN>222333444</ns1:OEN>
        <ns1:Phone>(204) 555-0104</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>H0H0H0</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 4: duplicate OEN with student 3 -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Blue</ns1:First>
          <ns1:Last>Berry</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2012-03-10</ns1:BirthDate>
        <ns1:Grade>1</ns1:Grade>
        <ns1:Gender>N</ns1:Gender>
        <ns1:OEN>222333444</ns1:OEN>
        <ns1:Phone>1-204-555-0105</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>H0H 0H0</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Postal-code focused cases: deterministic fixes and unresolved errors -->

      <!-- Student 5: I-to-1 substitutions in numeric positions plus slash normalization -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Indiana</ns1:First>
          <ns1:Last>Jones</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-01-05</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000005</ns1:OEN>
        <!-- Auto-fix: uppercase X becomes canonical lowercase x. -->
        <ns1:Phone>204-555-0106X12</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>HIH/IHI</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 6: L-to-1 substitution in a numeric position -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Lara</ns1:First>
          <ns1:Last>Croft</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-02-06</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000006</ns1:OEN>
        <ns1:Phone>204-155-0100</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>HLH1H1</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 7: O-to-0 substitution in a numeric position (valid rural FSA) -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Oscar</ns1:First>
          <ns1:Last>Grouch</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-03-07</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000007</ns1:OEN>
        <!-- Auto-fix: hash extension marker becomes canonical x. -->
        <ns1:Phone>212-555-0100 #23</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>HOH0H0</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 8: lowercase plus a Unicode dash; formatting-only normalization -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Princess</ns1:First>
          <ns1:Last>Peach</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-04-08</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000008</ns1:OEN>
        <!-- Auto-fix: country code, formatting, and spaced extension marker. -->
        <ns1:Phone>+1 (204) 555-0107 x 45</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>h0h—0h0</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 9: prohibited D in an alphabetic position; not auto-fixable -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Bugs</ns1:First>
          <ns1:Last>Bunny</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-05-09</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000009</ns1:OEN>
        <ns1:Phone>019-555-0100</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>D0H0H0</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 10: separator in the wrong position; not auto-fixable -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Kermit</ns1:First>
          <ns1:Last>Frog</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-06-10</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000010</ns1:OEN>
        <ns1:Phone>204-555-010</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>H0/H0H0</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Student 11: full-word extension variant; safely normalized -->
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Darth</ns1:First>
          <ns1:Last>Tater</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2014-07-11</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000011</ns1:OEN>
        <ns1:Phone>204-555-0108 extension 2</ns1:Phone>
        <ns1:Address>
          <ns1:City>Exampleville</ns1:City>
          <ns1:Province>ON</ns1:Province>
          <ns1:PostalCode>H0H!!!0H0</ns1:PostalCode>
        </ns1:Address>
      </ns1:Student>

      <!-- Phone-focused cases retained from the former dedicated demo -->

      <!-- Student 12: NPA begins with 1; not auto-fixable -->
      <ns1:Student>
        <ns1:Name><ns1:First>One NPA</ns1:First><ns1:Last>Structure</ns1:Last></ns1:Name>
        <ns1:BirthDate>2014-08-12</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000012</ns1:OEN>
        <ns1:Phone>119-555-0100</ns1:Phone>
      </ns1:Student>

      <!-- Student 13: extension exceeds the maximum; not auto-fixable -->
      <ns1:Student>
        <ns1:Name><ns1:First>Too Many</ns1:First><ns1:Last>Digits</ns1:Last></ns1:Name>
        <ns1:BirthDate>2014-09-13</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000013</ns1:OEN>
        <ns1:Phone>204-555-0109x123456</ns1:Phone>
      </ns1:Student>

      <!-- Student 14: multiple numbers; not auto-fixable -->
      <ns1:Student>
        <ns1:Name><ns1:First>Multiple</ns1:First><ns1:Last>Numbers</ns1:Last></ns1:Name>
        <ns1:BirthDate>2014-10-14</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000014</ns1:OEN>
        <ns1:Phone>204-555-0110 / 416-555-0111</ns1:Phone>
      </ns1:Student>

      <!-- Student 15: future Canadian relief NPA; warning only -->
      <ns1:Student>
        <ns1:Name><ns1:First>Future Relief</ns1:First><ns1:Last>Policy</ns1:Last></ns1:Name>
        <ns1:BirthDate>2014-11-15</ns1:BirthDate>
        <ns1:Grade>GR5</ns1:Grade>
        <ns1:Gender>X</ns1:Gender>
        <ns1:OEN>500000015</ns1:OEN>
        <ns1:Phone>851-555-0112</ns1:Phone>
      </ns1:Student>

    </ns1:Students>
  </ns1:School>

  <!-- Second school: empty Students element -->
  <ns1:School>
    <ns1:Name>Empty Eggplant Secondary</ns1:Name>
    <ns1:Students/>
  </ns1:School>

  <!-- Third school: missing SchoolNumber and non-ISO BirthDate and invalid grade -->
  <ns1:School>
    <ns1:Name>No-Number Nectarine School</ns1:Name>
    <ns1:Students>
      <ns1:Student>
        <ns1:Name>
          <ns1:First>Charlie</ns1:First>
          <ns1:Last>Brown</ns1:Last>
        </ns1:Name>
        <ns1:BirthDate>2013/05/05</ns1:BirthDate>
        <ns1:Grade>GR100</ns1:Grade>
        <ns1:Gender>unknown</ns1:Gender>
        <ns1:OEN>333444555</ns1:OEN>
        <ns1:Phone>600-555-0113</ns1:Phone>
      </ns1:Student>
    </ns1:Students>
  </ns1:School>

</ns1:SchoolUpload>
